{
  "rules": {
    ".read": "auth != null",
    ".write": "auth != null",
    "users": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid == $uid"
      }
    },
    "weddings": {
      ".indexOn": ["date", "createdAt"]
    },
    "history": {
      ".indexOn": ["date", "archivedAt"]
    },
    "chats": {
      "main": {
        "messages": {
          ".indexOn": ["createdAt"]
        }
      }
    }
  }
}
